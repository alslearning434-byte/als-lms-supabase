rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own user profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Allow reads for any authenticated user (needed for role lookup)
      allow get: if request.auth != null;
    }

    // Allow authenticated users to read/write their submissions
    match /assessmentSubmissions/{submissionId} {
      allow read, write: if request.auth != null;
    }

    // Resources — teachers can create, all authenticated users can read
    match /resources/{resourceId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Activities log — system and authenticated users
    match /activities/{activityId} {
      allow read, create: if request.auth != null;
    }

    // Backups — admin only
    match /backups/{backupId} {
      allow read, write: if request.auth != null;
    }

    // Module progress — users can read/write their own
    match /moduleProgress/{progressId} {
      allow read, write: if request.auth != null;
    }

    // Default: allow authenticated users
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}